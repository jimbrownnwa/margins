# Margins secrets. This file is gitignored. Never commit it.
# Fill in each empty value. Lines marked (done) are already set.

# --- Trigger.dev ---
# (done) Project ref
TRIGGER_PROJECT_REF=
# Production secret key: Trigger.dev dashboard > your project > API Keys > Production (starts with tr_prod_)
TRIGGER_SECRET_KEY=
# Personal access token for deploys: Trigger.dev dashboard > Account (avatar) > Personal Access Tokens (starts with tr_pat_)
TRIGGER_ACCESS_TOKEN=

# --- Anthropic ---
# Claude Console (platform.claude.com) > API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=

# --- Telegram ---
# From @BotFather after /newbot (looks like 123456789:ABC...)
TELEGRAM_BOT_TOKEN=
# (done) Random secret Telegram sends with each webhook call so we can verify it. Leave as is.
# Leave blank. I'll fill this in after you message the bot once.
TELEGRAM_ALLOWED_CHAT_ID=

# --- Supabase ---
# Leave blank if you want me to create the project through the Supabase connector.
# Otherwise: Project Settings > API > Project URL and the service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for deploys and migrations: supabase.com/dashboard/account/tokens (starts with sbp_)
SUPABASE_ACCESS_TOKEN=

# --- OpenAI (embeddings only, for finding related notes; model text-embedding-3-small) ---
# platform.openai.com > API keys (starts with sk-)
OPENAI_API_KEY=
TELEGRAM_WEBHOOK_SECRET=
